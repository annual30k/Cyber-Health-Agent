{
  "id": "obsidian-memory-plugin",
  "name": "Obsidian Memory",
  "version": "0.3.2",
  "description": "Load the bundled self-growing memory skill and an explicit Obsidian connection.",
  "skills": ["./skills"],
  "activation": { "onStartup": true, "onCapabilities": ["hook"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "anyOf": [
      { "maxProperties": 0 },
      { "required": ["agentId", "vaultPath"] }
    ],
    "properties": {
      "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "vault": { "type": "string", "minLength": 1, "maxLength": 256 },
      "vaultPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "cliPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "projectId": {
        "type": "string", "maxLength": 128,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
      },
      "projectRoot": { "type": "string", "minLength": 1, "maxLength": 4096 }
    }
  },
  "uiHints": {
    "agentId": { "label": "OpenClaw agent ID" },
    "vault": { "label": "Vault label (optional; used only for CLI operations)" },
    "vaultPath": { "label": "Absolute Vault root path" },
    "cliPath": { "label": "CLI executable for Obsidian app operations (default: obsidian)" },
    "projectId": { "label": "Default project ID (optional)" },
    "projectRoot": { "label": "Actual code project root (optional)" }
  }
}
